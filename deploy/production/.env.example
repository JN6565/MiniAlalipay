# =============================================================
# MiniAIalipay 生产部署环境变量模板
# 使用方法：复制为 .env 后填写需要覆盖的项；保持注释的变量
# 将沿用各服务 application.yml 中的内置默认值。
# 注意：不要保留“空值赋值”（如 PASSWORD=），空字符串会覆盖
# 代码默认值导致连接失败；不需要的项请整行注释。
# =============================================================

# ---------- 时区 ----------
TZ=Asia/Shanghai

# ---------- Nacos（服务注册与发现，含 Seata TC 发现） ----------
NACOS_SERVER_ADDR=121.43.51.164:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
# 命名空间留空表示 public
# NACOS_NAMESPACE=

# ---------- Redis ----------
REDIS_HOST=121.43.51.164
REDIS_PORT=6379
REDIS_PASSWORD=teamuser2026

# ---------- MySQL（四个限界上下文独立 Schema） ----------
# 连接串沿用代码默认值；如服务器数据库账号密码与开发环境不同，取消注释并修改
# USER_DB_URL=jdbc:mysql://121.43.51.164:3306/user_db?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
# USER_DB_USERNAME=root
# USER_DB_PASSWORD=teamuser2026
# BUSINESS_DB_USERNAME=root
# BUSINESS_DB_PASSWORD=teamuser2026
# ACCOUNT_DB_USERNAME=root
# ACCOUNT_DB_PASSWORD=teamuser2026
# AGENT_DB_USERNAME=root
# AGENT_DB_PASSWORD=teamuser2026

# ---------- 内部服务令牌 ----------
# 网关调用用户中心鉴权接口、各服务间内部接口均校验该令牌，全部服务必须一致。
# 生产环境必须改为强随机值（可用 openssl rand -hex 32 生成），禁止沿用开发默认值。
INTERNAL_SERVICE_TOKEN=local-internal-token
INTERNAL_AUTH_SERVICE_TOKEN=local-internal-token

# ---------- 网关鉴权模式 ----------
# 阶段二受控鉴权：默认关闭开发桩（stub），登录会话回源用户中心校验；
# 仅在无可用演示账号的本地演示场景才置为 true
# GATEWAY_AUTH_STUB_ENABLED=false
# CORS 允许来源（必填）：浏览器 POST 即使同源也会携带 Origin 头，不在白名单内的来源会被网关拒绝为 403。
# 必须包含两个前端的实际访问来源：H5 已经 443 TLS 提供（80 仅 301 跳转），故同时保留
# http 与 https 两种来源；管理端仍走 81 端口 HTTP。
GATEWAY_CORS_ORIGINS=https://121.43.51.164,http://121.43.51.164,http://121.43.51.164:81

# ---------- AI 服务 ----------
# DeepSeek API Key（以 sk- 开头为真实模式，否则自动降级 Mock 模式）
SPRING_AI_OPENAI_API_KEY=sk-0fbdcf2e0ae44affa6a4515f71680d8a

# ---------- Seata（转账 TCC 协调） ----------
# 默认经 Nacos SEATA_GROUP 发现 seata-server；如临时改用自研 HTTP 协调器，
# 设置 TCC_COORDINATOR=http（充值链路始终走 HTTP 协调，不受影响）
# SEATA_ENABLED=true
# TCC_COORDINATOR=seata

# ---------- JVM 内存预算（16G 服务器规划，合计约 2.8G 堆） ----------
GATEWAY_JAVA_OPTS=-Xms256m -Xmx512m -Dfile.encoding=UTF-8
USER_CENTER_JAVA_OPTS=-Xms256m -Xmx512m -Dfile.encoding=UTF-8
BUSINESS_CENTER_JAVA_OPTS=-Xms320m -Xmx640m -Dfile.encoding=UTF-8
ACCOUNT_CENTER_JAVA_OPTS=-Xms320m -Xmx640m -Dfile.encoding=UTF-8
AI_SERVICE_JAVA_OPTS=-Xms256m -Xmx512m -Dfile.encoding=UTF-8
