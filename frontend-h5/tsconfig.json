{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@@/*": ["src/.umi/*"],
      "umi": ["src/.umi/exports.ts"],
      "@umijs/max": ["src/.umi/exports.ts"]
    }
  },
  "include": ["src/**/*", "config/**/*", "typings/**/*"],
  "exclude": ["node_modules", "dist", "mock"]
}
