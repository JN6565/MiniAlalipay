{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minialalipay.com/schemas/agent-reply/v1",
  "title": "AgentReply",
  "description": "AI Agent 结构化回复（v1），LLM 输出必须符合此 Schema",
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "TRANSFER", "BALANCE_QUERY", "TRANSACTION_LIST",
        "TRANSACTION_STATUS", "USER_SEARCH", "CREDIT_SUMMARY",
        "CREDIT_BILL", "CREDIT_REPAYMENT", "UNKNOWN"
      ],
      "description": "识别的用户意图，UNKNOWN 表示无法确定"
    },
    "slots": {
      "type": "object",
      "description": "从用户输入中提取的结构化槽位，值可为 null",
      "properties": {
        "payeeQuery": { "type": ["string", "null"], "description": "收款人搜索关键词" },
        "payeeName": { "type": ["string", "null"], "description": "收款人姓名" },
        "payeeId": { "type": ["string", "null"], "description": "收款人用户ID" },
        "amountFen": { "type": ["integer", "null"], "format": "int64", "minimum": 0, "description": "金额（分）" },
        "remark": { "type": ["string", "null"], "maxLength": 50, "description": "转账备注" },
        "transactionId": { "type": ["string", "null"], "description": "交易ID" },
        "limit": { "type": ["integer", "null"], "default": 10, "maximum": 50 },
        "query": { "type": ["string", "null"], "maxLength": 64 }
      },
      "additionalProperties": true
    },
    "missingFields": {
      "type": "array",
      "items": { "type": "string" },
      "description": "缺失的必填字段名列表"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "意图置信度"
    },
    "clarificationNeeded": {
      "type": "boolean",
      "description": "是否需要向用户澄清缺失信息"
    },
    "naturalReply": {
      "type": "string",
      "maxLength": 2000,
      "description": "面向用户展示的自然语言回复"
    }
  },
  "required": ["intent", "slots", "missingFields", "confidence", "clarificationNeeded", "naturalReply"],
  "additionalProperties": false
}
