<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  凭证 Mapper XML 映射文件。

  定义 credential 表的 SQL 操作，包括插入、查询和更新。
  所有 SQL 语句使用 MyBatis 动态 SQL 语法，避免 SQL 注入。

  命名规范：
  - insert: 插入新记录
  - selectByXxx: 按条件查询单条记录
  - update: 更新记录（使用乐观锁 version）

  注意事项：
  - 所有时间字段使用 java.time.Instant，MyBatis 自动处理 UTC 转换
  - 更新操作必须包含 WHERE version = #{expectedVersion}，防止并发覆盖
  - 凭证表与用户表在同一事务内保存，保证注册的原子性
-->
<mapper namespace="com.minialalipay.user.infrastructure.persistence.mapper.CredentialMapper">

    <!-- 结果映射：将数据库字段映射到 Java 对象 -->
    <resultMap id="credentialResultMap" type="com.minialalipay.user.infrastructure.persistence.po.CredentialPO">
        <id property="userId" column="user_id"/>
        <result property="loginPasswordHash" column="login_password_hash"/>
        <result property="paymentPasswordHash" column="payment_password_hash"/>
        <result property="loginFailCount" column="login_fail_count"/>
        <result property="payFailCount" column="pay_fail_count"/>
        <result property="loginLockUntil" column="login_lock_until"/>
        <result property="payLockUntil" column="pay_lock_until"/>
        <result property="payPasswordVersion" column="pay_password_version"/>
        <result property="version" column="version"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!--
      插入新凭证记录。

      注册时调用，插入新凭证记录到 credential 表。
      必须与用户记录在同一事务内保存，保证注册的原子性。

      参数：
      - credential: 凭证持久化对象

      返回值：
      - 插入的行数（成功时返回 1）
    -->
    <insert id="insert" parameterType="com.minialalipay.user.infrastructure.persistence.po.CredentialPO">
        INSERT INTO credential (
            user_id,
            login_password_hash,
            payment_password_hash,
            login_fail_count,
            pay_fail_count,
            login_lock_until,
            pay_lock_until,
            pay_password_version,
            version,
            updated_at
        ) VALUES (
            #{userId},
            #{loginPasswordHash},
            #{paymentPasswordHash},
            #{loginFailCount},
            #{payFailCount},
            #{loginLockUntil},
            #{payLockUntil},
            #{payPasswordVersion},
            #{version},
            #{updatedAt}
        )
    </insert>

    <!--
      根据用户 ID 查询凭证。

      参数：
      - userId: 用户 ID（26 位字符，USR 前缀）

      返回值：
      - 凭证持久化对象，如果不存在则返回 null
    -->
    <select id="selectByUserId" parameterType="string" resultMap="credentialResultMap">
        SELECT
            user_id,
            login_password_hash,
            payment_password_hash,
            login_fail_count,
            pay_fail_count,
            login_lock_until,
            pay_lock_until,
            pay_password_version,
            version,
            updated_at
        FROM credential
        WHERE user_id = #{userId}
    </select>

    <!--
      更新凭证信息。

      更新密码、失败次数或锁定状态时调用。
      使用乐观锁（version）保证并发安全，更新成功后 version 自动递增 1。

      参数：
      - credential: 凭证持久化对象（包含更新后的数据）

      返回值：
      - 更新的行数（成功时返回 1，版本冲突时返回 0）
    -->
    <update id="update" parameterType="com.minialalipay.user.infrastructure.persistence.po.CredentialPO">
        UPDATE credential
        SET
            login_password_hash = #{loginPasswordHash},
            payment_password_hash = #{paymentPasswordHash},
            login_fail_count = #{loginFailCount},
            pay_fail_count = #{payFailCount},
            login_lock_until = #{loginLockUntil},
            pay_lock_until = #{payLockUntil},
            pay_password_version = #{payPasswordVersion},
            version = version + 1,
            updated_at = #{updatedAt}
        WHERE user_id = #{userId}
          AND version = #{version}
    </update>

</mapper>
